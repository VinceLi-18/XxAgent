POSTGRES_DB=xagent_api
POSTGRES_USER=xagent_api
POSTGRES_PASSWORD=replace-for-local-development
POSTGRES_APP_USER=xagent_app
POSTGRES_APP_PASSWORD=replace-for-local-development
DATABASE_URL=postgresql+asyncpg://${POSTGRES_APP_USER}:${POSTGRES_APP_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_ADMIN_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# 在共享或生产环境使用前，必须替换此占位值。
# 可通过 openssl rand -hex 32 生成高熵值。
JWT_SECRET_KEY=replace-with-a-generated-high-entropy-secret
JWT_ISSUER=xagent-local
JWT_AUDIENCE=xagent-api
# 仅供 DSH Host 调用 /internal/xagent/*，不得暴露给浏览器。
# 可通过 openssl rand -hex 32 生成独立高熵值。
XAGENT_SERVICE_TOKEN=replace-with-a-separate-high-entropy-service-token
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-for-local-development
MINIO_ENDPOINT=minio:9000
# 仅用于生成浏览器可访问的暂存 PUT 预签名地址。
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-for-local-development
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MINIO_BUCKET=xagent-private
MAX_ARTIFACT_SIZE_BYTES=52428800
STAGING_EXPIRY_DAYS=1
CLAMAV_TIMEOUT=10
