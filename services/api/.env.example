POSTGRES_DB=xagent_api
POSTGRES_USER=xagent_api
POSTGRES_PASSWORD=replace-for-local-development
POSTGRES_APP_USER=xagent_app
POSTGRES_APP_PASSWORD=replace-for-local-development
# 仅供资料扫描 worker 使用；请为部署生成独立密码，不得复用应用角色密码。
POSTGRES_WORKER_USER=xagent_worker
POSTGRES_WORKER_PASSWORD=replace-with-a-separate-worker-password
# 三条连接 URL 均不拼入原始密码；应用通过独立环境变量把密码传给 asyncpg。
DATABASE_URL=postgresql+asyncpg://${POSTGRES_APP_USER}@postgres:5432/${POSTGRES_DB}
DATABASE_ADMIN_URL=postgresql+asyncpg://${POSTGRES_USER}@postgres:5432/${POSTGRES_DB}
# 只注入 worker 进程，API 不读取此连接。
DATABASE_WORKER_URL=postgresql+asyncpg://${POSTGRES_WORKER_USER}@postgres:5432/${POSTGRES_DB}
# 在共享或生产环境使用前，必须替换此占位值。
# 可通过 openssl rand -hex 32 生成高熵值。
JWT_SECRET_KEY=replace-with-a-generated-high-entropy-secret
JWT_ISSUER=xagent-local
JWT_AUDIENCE=xagent-api
# 仅供 DSH Host 调用 /internal/xagent/*，不得暴露给浏览器。
# 可通过 openssl rand -hex 32 生成独立高熵值。
XAGENT_SERVICE_TOKEN=replace-with-a-separate-high-entropy-service-token
# FastAPI 仅接收 Host 委托签名密钥对应的原始 Ed25519 公钥（Base64）。
XAGENT_DELEGATION_PUBLIC_KEY=replace-with-the-host-ed25519-public-key
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-for-local-development
MINIO_ENDPOINT=minio:9000
# 仅用于生成浏览器可访问的暂存 PUT 预签名地址。
MINIO_PUBLIC_ENDPOINT=localhost:9000
# 公开签名 URL 使用的 MinIO region；必须与对象存储部署一致。
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-for-local-development
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MINIO_BUCKET=xagent-private
MAX_ARTIFACT_SIZE_BYTES=52428800
STAGING_EXPIRY_DAYS=1
MINIO_TIMEOUT=10
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=10
# 仅供 API 与 worker 访问的内部 CPU Embedding 地址；不得发布其容器端口。
EMBEDDING_URL=http://embedding:8000
# 同时约束查询和批量索引请求。
EMBEDDING_TIMEOUT=120
# BGE-M3 固定修订的本地缓存；首次启动前确保目录可由容器用户 65532 写入。
XAGENT_EMBEDDING_CACHE_DIR=./.cache/huggingface
# 只在缓存已按固定修订和发布内容摘要验证完整时启用。
HF_HUB_OFFLINE=false
